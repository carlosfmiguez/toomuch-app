# Copie para .env e ajuste. Sem .env o projeto roda com SQLite e arquivos locais.

DEBUG=True
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1,app.toomuch.art
CSRF_TRUSTED_ORIGINS=https://app.toomuch.art

# Banco: SQLite (desenvolvimento) ou Postgres (produção / docker compose)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://toomuch:toomuch@db:5432/toomuch

# Storage S3-compatível (Cloudflare R2). Vazio = disco local em ./media
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=

TIME_ZONE=America/Sao_Paulo
